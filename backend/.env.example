# AI Stock 环境配置

# 应用配置
APP_NAME=AI Stock Trading System
DEBUG=true
API_PREFIX=/api

# 数据库配置
DATABASE_URL=postgresql+asyncpg://aistock:aistock123@localhost:5432/aistock
REDIS_URL=redis://localhost:6379
MONGODB_URL=mongodb://localhost:27017/aistock

# LLM配置（OpenAI 兼容协议：kimi/deepseek/openai 等）
LLM_BASE_URL=https://api.kimi.com/coding
LLM_API_KEY=sk-your-key-here
LLM_MODEL=k3
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=2048
LLM_TIMEOUT=120

# 飞书推送配置
FEISHU_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/your-webhook
FEISHU_APP_ID=
FEISHU_APP_SECRET=

# 行情数据源 (tdx, eastmoney, tushare)
MARKET_DATA_SOURCE=tdx

# 同花顺 iFinD 官方数据接口（https://quantapi.51ifind.com 注册即有免费额度）
# refresh_token 获取：iFinD SDK 包 → 超级命令 → 工具 → refresh_token 查询
IFIND_REFRESH_TOKEN=
# 行情通道优先级: auto(ifind→tencent→eastmoney) | ifind | tencent | eastmoney | free(tencent→eastmoney) | mock
MARKET_DATA_PRIORITY=auto
# 问财免费通道 cookie（可选，需 pip install pywencai）
PYWENCAI_COOKIE=

# 天眼查开放平台（https://www.tianyancha.com/data 申请 token，接口按次计费）
TIANYANCHA_TOKEN=
TIANYANCHA_DAILY_LIMIT=100

# 券商配置 (pingan, tiger, futu)
BROKER_TYPE=pingan

# 风控配置（10万资金）
MAX_POSITION_RATIO=0.2
MAX_TOTAL_POSITIONS=5
STOP_LOSS_RATIO=0.05
DAILY_LOSS_LIMIT=0.015
WEEKLY_LOSS_LIMIT=0.05
MIN_TRADE_AMOUNT=2000

# 回测配置
BACKTEST_COMMISSION=0.00025
BACKTEST_STAMP_TAX=0.001
BACKTEST_SLIPPAGE=0.001
